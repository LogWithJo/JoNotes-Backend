// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String?              // now optional — OAuth-only users won't have one
  name      String?              // populated from OAuth profile if available
  avatar    String?              // profile picture URL from Google/GitHub
  createdAt DateTime  @default(now())
  notes     Note[]
  accounts  Account[]            // one user, many linked login methods
}

model Account {
  id                Int      @id @default(autoincrement())
  provider          String   // "google" | "github"
  providerAccountId String   // the unique id Google/GitHub gives that user ("sub" / "id")
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}
model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  category  String
  isPin     Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}